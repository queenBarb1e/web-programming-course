generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"         
 
}

model User {
  id        String   @id @default(cuid())     
  email     String   @unique
  name      String?
  githubId  String   @unique                 
  createdAt DateTime @default(now())

  @@map("users")   // название таблицы  
}
